---
import { Image } from 'astro:assets';
import { images } from '@/assets/images';
import { siteConfig, zoneLinks, whatsappUrl, whatsappAriaLabel } from '@/site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <a href="/" class="footer-logo-link" aria-label={`${siteConfig.siteShortName} — página inicial`}>
        <Image
          src={images.logoPrincipal}
          alt="Conserto de Máquina de Lavar no RJ"
          title="Conserto de Máquina de Lavar no RJ"
          width={200}
          height={73}
          loading="lazy"
          class="footer-logo"
        />
      </a>
      <p>
        Atendimento especializado em manutenção e reparo de máquinas de lavar no Rio de Janeiro,
        com serviço em domicílio, diagnóstico técnico e experiência no mercado desde
        {siteConfig.startYear}.
      </p>
      <p class="footer-phone">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label={whatsappAriaLabel}>
          WhatsApp: {siteConfig.phoneDisplay}
        </a>
      </p>
    </div>

    <div class="footer-col">
      <h2>Navegação</h2>
      <ul>
        {siteConfig.mainNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h2><a href="/areas-atendidas/">Área de Atendimento</a></h2>
      <p>Atendemos todo o Rio de Janeiro.</p>
      <ul>
        {siteConfig.regions.map((region) => {
          const href = zoneLinks[region];
          return <li>{href ? <a href={href}>{region}</a> : region}</li>;
        })}
      </ul>
    </div>

    <div class="footer-col">
      <h2>Links Úteis</h2>
      <ul>
        {siteConfig.footerLegalNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {year} {siteConfig.siteName}. Todos os direitos reservados.</p>
      <p>Assistência técnica especializada e independente, sem vínculo com fabricantes.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer);
    color: #cbd5e1;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    padding-block: 56px 40px;
  }

  .footer-grid > * {
    min-width: 0;
  }

  .footer-col h2 {
    color: var(--white);
    font-size: 1.02rem;
    margin-bottom: 18px;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a {
    text-decoration: none;
    color: #cbd5e1;
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: var(--cyan);
  }

  .footer-logo-link {
    display: inline-flex;
    background: var(--white);
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    margin-bottom: 18px;
  }

  .footer-logo {
    width: 170px;
    height: auto;
    display: block;
  }

  .footer-about p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #b6c2d9;
  }

  .footer-phone a {
    font-weight: 700;
    color: var(--cyan);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-bottom-inner {
    padding-block: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.85rem;
    color: #8ea0bf;
  }

  .footer-bottom-inner p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

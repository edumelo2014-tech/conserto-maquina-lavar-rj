---
import Icon from './icons/Icon.astro';
import type { ServiceProcessStep } from '@/data/serviceProcess';

interface Props {
  steps: ServiceProcessStep[];
}

const { steps } = Astro.props;
---

<ol class="mini-steps">
  {steps.map((step) => (
    <li>
      <Icon name={step.icon} size={20} />
      {step.label}
    </li>
  ))}
</ol>

<style>
  .mini-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .mini-steps li {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    color: var(--white);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .mini-steps :global(svg) {
    color: var(--cyan);
    flex-shrink: 0;
  }

  @media (max-width: 780px) {
    .mini-steps {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { images } from '@/assets/images';
import { siteConfig, whatsappUrl, whatsappAriaLabel } from '@/site.config';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="logo-link" aria-label={`${siteConfig.siteShortName} — página inicial`}>
      <Image
        src={images.logoPrincipal}
        alt="Conserto de Máquina de Lavar no RJ"
        title="Conserto de Máquina de Lavar no RJ"
        width={235}
        height={86}
        loading="eager"
        fetchpriority="high"
        class="logo-img"
      />
    </a>

    <nav class="main-nav" aria-label="Navegação principal">
      <ul>
        {siteConfig.mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a
        href={whatsappUrl}
        class="btn btn-whatsapp header-cta"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={whatsappAriaLabel}
      >
        <WhatsAppIcon size={18} />
        <span>Solicitar Orçamento</span>
      </a>

      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">Abrir menu de navegação</span>
        <span class="menu-toggle-bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Navegação móvel">
      <ul>
        {siteConfig.mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      href={whatsappUrl}
      class="btn btn-whatsapp btn-block"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={whatsappAriaLabel}
    >
      <WhatsAppIcon size={18} />
      <span>Solicitar Orçamento</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 950;
    background: var(--white);
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition:
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .site-header.is-scrolled {
    box-shadow: var(--shadow-md);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    width: clamp(150px, 18vw, 235px);
    height: auto;
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    text-decoration: none;
    font-weight: 600;
    color: var(--text);
    padding: 8px 2px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .main-nav a:hover {
    color: var(--electric);
  }

  .main-nav a[aria-current='page'] {
    color: var(--electric);
    border-bottom-color: var(--electric);
  }

  .main-nav a:focus-visible,
  .header-cta:focus-visible {
    outline: 3px solid var(--electric);
    outline-offset: 3px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .header-cta {
    padding: 11px 20px;
    font-size: 0.92rem;
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .menu-toggle:focus-visible {
    outline: 3px solid var(--electric);
    outline-offset: 2px;
  }

  .menu-toggle-bars {
    display: block;
    width: 22px;
    height: 16px;
    position: relative;
  }

  .menu-toggle-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-toggle-bars span:nth-child(1) {
    top: 0;
  }
  .menu-toggle-bars span:nth-child(2) {
    top: 7px;
  }
  .menu-toggle-bars span:nth-child(3) {
    top: 14px;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle-bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle-bars span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Estado padrão: escondido em qualquer largura. A regra abaixo, mais
     específica que "display: none", é o que de fato exibe o menu quando o
     JS remove o atributo "hidden" — sem ela, o menu nunca aparece mesmo
     com o estado (aberto/fechado) sendo alternado corretamente. */
  .mobile-menu {
    display: none;
  }

  .mobile-menu:not([hidden]) {
    display: block;
  }

  @media (max-width: 880px) {
    .main-nav {
      display: none;
    }

    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-menu:not([hidden]) {
      position: fixed;
      inset: var(--header-height) 0 0 0;
      background: var(--white);
      padding: 28px 20px;
      overflow-y: auto;
      z-index: 940;
    }

    .mobile-menu nav ul {
      list-style: none;
      margin: 0 0 24px;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .mobile-menu nav a {
      display: block;
      text-decoration: none;
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--primary);
      padding: 14px 6px;
      border-bottom: 1px solid var(--border);
    }

    .mobile-menu nav a[aria-current='page'] {
      color: var(--electric);
    }
  }
</style>

<script is:inline>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 4);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function closeMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    menu.hidden = true;
    document.body.style.overflow = '';
  }

  function openMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'true');
    menu.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    expanded ? closeMenu() : openMenu();
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 880) closeMenu();
  });
</script>

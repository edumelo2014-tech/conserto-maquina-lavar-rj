---
const rows = [
  { situation: 'Máquina conservada e defeito isolado', evaluation: 'Geralmente vale avaliar o reparo' },
  { situation: 'Problema em bomba, válvula ou correia', evaluation: 'Muitas vezes o reparo é viável' },
  { situation: 'Falha na placa eletrônica', evaluation: 'Depende do modelo e do custo do componente' },
  { situation: 'Estrutura muito oxidada', evaluation: 'Pode não compensar' },
  { situation: 'Vários defeitos simultâneos', evaluation: 'Requer avaliação técnica mais cuidadosa' },
];
---

<div class="table-scroll repair-worth-table">
  <table>
    <caption class="visually-hidden">Orientações gerais sobre quando vale a pena consertar a máquina de lavar</caption>
    <thead>
      <tr>
        <th scope="col">Situação</th>
        <th scope="col">Avaliação inicial</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <td>{row.situation}</td>
          <td>{row.evaluation}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .repair-worth-table {
    background: var(--white);
  }

  .repair-worth-table td {
    color: var(--text);
  }
</style>

---
import Icon from './icons/Icon.astro';

const bbox = '-43.7955,-23.0821,-43.0964,-22.7469';
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik`;
---

<div class="map-section">
  <div class="map-frame" id="map-frame">
    <div class="map-placeholder" id="map-placeholder">
      <Icon name="map-pin" size={34} class="map-placeholder-icon" />
      <p>Mapa da área de atendimento — cidade do Rio de Janeiro</p>
      <button type="button" class="btn btn-outline-primary" id="load-map-btn">
        Carregar mapa
      </button>
    </div>
  </div>
  <p class="map-caption">
    O atendimento é realizado em diferentes regiões da cidade do Rio de Janeiro. Informe seu
    bairro ao solicitar o orçamento.
  </p>
</div>

<script define:vars={{ mapSrc }} is:inline>
  const btn = document.getElementById('load-map-btn');
  const placeholder = document.getElementById('map-placeholder');
  const frame = document.getElementById('map-frame');

  btn?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = mapSrc;
    iframe.title = 'Mapa da área de atendimento na cidade do Rio de Janeiro';
    iframe.loading = 'lazy';
    iframe.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
    iframe.style.width = '100%';
    iframe.style.height = '100%';
    iframe.style.border = '0';
    placeholder?.remove();
    frame?.appendChild(iframe);
  });
</script>

<style>
  .map-section {
    display: grid;
    gap: 14px;
  }

  .map-frame {
    width: 100%;
    aspect-ratio: 16 / 8;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--light);
  }

  .map-placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
    padding: 20px;
    background: linear-gradient(135deg, #eef3fb, #e4ecfa);
  }

  .map-placeholder-icon {
    color: var(--electric);
  }

  .map-placeholder p {
    color: var(--primary);
    font-weight: 700;
    margin: 0;
  }

  .map-caption {
    color: var(--muted);
    font-size: 0.94rem;
    margin: 0;
  }
</style>

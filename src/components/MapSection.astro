---
import Icon from './icons/Icon.astro';

const bbox = '-43.7955,-23.0821,-43.0964,-22.7469';
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik`;
---

<div class="map-section">
  <div class="map-frame" id="map-frame">
    <div class="map-placeholder" id="map-placeholder">
      <Icon name="map-pin" size={34} class="map-placeholder-icon" />
      <p>Mapa da área de atendimento — cidade do Rio de Janeiro</p>
      <button type="button" class="btn btn-outline-primary" id="load-map-btn">
        Carregar mapa
      </button>
    </div>
    <iframe
      id="map-iframe"
      class="map-iframe"
      title="Mapa da área de atendimento na cidade do Rio de Janeiro"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      hidden
    ></iframe>
  </div>
  <p class="map-caption">
    O atendimento é realizado em diferentes regiões da cidade do Rio de Janeiro. Informe seu
    bairro ao solicitar o orçamento.
  </p>
</div>

<script define:vars={{ mapSrc }} is:inline>
  (function () {
    var btn = document.getElementById('load-map-btn');
    var placeholder = document.getElementById('map-placeholder');
    var iframe = document.getElementById('map-iframe');

    if (!btn || !iframe) return;

    btn.addEventListener('click', function () {
      iframe.setAttribute('src', mapSrc);
      iframe.hidden = false;
      if (placeholder) {
        placeholder.hidden = true;
      }
    });
  })();
</script>

<style>
  .map-section {
    display: grid;
    gap: 14px;
  }

  .map-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 8;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--light);
  }

  .map-placeholder {
    position: absolute;
    inset: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
    padding: 20px;
    background: linear-gradient(135deg, #eef3fb, #e4ecfa);
  }

  .map-placeholder[hidden] {
    display: none;
  }

  .map-placeholder-icon {
    color: var(--electric);
  }

  .map-placeholder p {
    color: var(--primary);
    font-weight: 700;
    margin: 0;
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .map-iframe[hidden] {
    display: none;
  }

  .map-caption {
    color: var(--muted);
    font-size: 0.94rem;
    margin: 0;
  }
</style>

---
import type { Neighborhood } from '@/data/neighborhoods';
import { getNeighborhoodPage } from '@/data/neighborhoodPages';

interface Props {
  neighborhoods: Neighborhood[];
}

const { neighborhoods } = Astro.props;
---

<ul class="neighborhood-list">
  {neighborhoods.map((neighborhood) => {
    const page = getNeighborhoodPage(neighborhood.slug);
    return (
      <li>
        {page ? (
          <a class="neighborhood-item" href={page.path} data-slug={neighborhood.slug}>
            {neighborhood.nome}
          </a>
        ) : (
          <span class="neighborhood-item" data-slug={neighborhood.slug}>
            {neighborhood.nome}
          </span>
        )}
      </li>
    );
  })}
</ul>

<style>
  .neighborhood-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }

  .neighborhood-item {
    display: block;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 12px;
    text-align: center;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--primary);
    text-decoration: none;
  }

  a.neighborhood-item {
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  a.neighborhood-item:hover,
  a.neighborhood-item:focus-visible {
    border-color: var(--electric);
    box-shadow: var(--shadow-sm);
  }

  a.neighborhood-item:focus-visible {
    outline: 3px solid var(--electric);
    outline-offset: 2px;
  }

  @media (max-width: 780px) {
    .neighborhood-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 500px) {
    .neighborhood-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

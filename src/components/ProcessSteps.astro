---
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="process-steps">
  {steps.map((step, index) => (
    <li class="process-step">
      <div class="process-number" aria-hidden="true">{index + 1}</div>
      <h3>{step.title}</h3>
      <p>{step.description}</p>
    </li>
  ))}
</ol>

<style>
  .process-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    counter-reset: step;
  }

  .process-step {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    padding: 22px 18px;
    position: relative;
  }

  .process-number {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--cyan);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.05rem;
    margin-bottom: 14px;
  }

  .process-step h3 {
    font-size: 0.98rem;
    color: var(--white);
    margin-bottom: 8px;
  }

  .process-step p {
    font-size: 0.87rem;
    color: #cfdaf0;
    margin-bottom: 0;
  }

  @media (max-width: 980px) {
    .process-steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 620px) {
    .process-steps {
      grid-template-columns: 1fr;
    }
  }
</style>

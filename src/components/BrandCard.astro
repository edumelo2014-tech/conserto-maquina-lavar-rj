---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  description: string;
}

const { image, alt, title, description } = Astro.props;
---

<article class="brand-card card">
  <div class="brand-logo-frame">
    <Image src={image} alt={alt} width={160} height={90} loading="lazy" class="brand-logo-img" />
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</article>

<style>
  .brand-card {
    padding: 22px;
    text-align: center;
  }

  .brand-logo-frame {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
    margin-bottom: 16px;
    transition: box-shadow 0.15s ease;
  }

  .brand-card:hover .brand-logo-frame {
    box-shadow: var(--shadow-sm);
  }

  .brand-logo-img {
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  .brand-card h3 {
    font-size: 1rem;
    color: var(--primary);
    margin-bottom: 6px;
  }

  .brand-card p {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }
</style>

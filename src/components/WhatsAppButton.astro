---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { whatsappUrl, whatsappUrlWithMessage, whatsappAriaLabel } from '@/site.config';

interface Props {
  label?: string;
  class?: string;
  variant?: 'solid' | 'block';
  message?: string;
}

const {
  label = 'Solicitar Orçamento no WhatsApp',
  class: className = '',
  variant = 'solid',
  message,
} = Astro.props;

const href = message ? whatsappUrlWithMessage(message) : whatsappUrl;

const classes = ['btn', 'btn-whatsapp', variant === 'block' ? 'btn-block' : '', className]
  .filter(Boolean)
  .join(' ');
---

<a
  href={href}
  class={classes}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={whatsappAriaLabel}
>
  <WhatsAppIcon size={20} />
  <span>{label}</span>
</a>

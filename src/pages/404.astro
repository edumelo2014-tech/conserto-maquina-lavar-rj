---
import BaseLayout from '@/layouts/BaseLayout.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';

const pageTitle = 'Página não encontrada | Conserto de Máquina de Lavar no RJ';
const pageDescription = 'A página que você procura não foi encontrada. Volte para a página inicial ou solicite um orçamento pelo WhatsApp.';
---

<BaseLayout title={pageTitle} description={pageDescription} path="/404/" noindex={true}>
  <section class="section section-light not-found">
    <div class="container not-found-content">
      <span class="not-found-code">404</span>
      <h1>Página não encontrada</h1>
      <p>
        O endereço acessado não existe ou foi movido. Você pode voltar para a página inicial ou
        falar diretamente pelo WhatsApp para solicitar o conserto da sua máquina de lavar.
      </p>
      <div class="not-found-actions">
        <a href="/" class="btn btn-outline-primary">Voltar para a Home</a>
        <WhatsAppButton />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(70px, 12vw, 130px);
  }

  .not-found-content {
    text-align: center;
    max-width: 560px;
    margin-inline: auto;
  }

  .not-found-code {
    display: block;
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 800;
    color: var(--electric);
    line-height: 1;
    margin-bottom: 12px;
  }

  .not-found-content h1 {
    color: var(--primary);
    font-size: 1.7rem;
  }

  .not-found-content p {
    color: var(--muted);
    margin-bottom: 28px;
  }

  .not-found-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BrandCard from '@/components/BrandCard.astro';
import NeighborhoodList from '@/components/NeighborhoodList.astro';
import MiniSteps from '@/components/MiniSteps.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import CTASection from '@/components/CTASection.astro';
import { images } from '@/assets/images';
import { services } from '@/data/services';
import { brands } from '@/data/brands';
import { zonaNorteNeighborhoods } from '@/data/neighborhoods';
import { serviceProcessSteps } from '@/data/serviceProcess';
import { organizationJsonLd, webPageJsonLd, servicesJsonLd } from '@/lib/jsonld';

const path = '/conserto-de-maquina-de-lavar-na-zona-norte-rj/';
const pageTitle = 'Conserto de Máquina de Lavar na Zona Norte RJ | Atendimento em Domicílio';
const pageDescription =
  'Conserto de máquina de lavar na Zona Norte RJ com atendimento em domicílio, diagnóstico técnico e orçamento antes do serviço em bairros como Tijuca, Méier e Madureira.';

const jsonLd = [
  organizationJsonLd(),
  webPageJsonLd(pageTitle, pageDescription, path),
  ...servicesJsonLd(services.map((s) => ({ name: s.title, description: s.longDescription }))),
];
---

<BaseLayout title={pageTitle} description={pageDescription} path={path} jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Zona Norte RJ', href: path }]} />
  </div>

  <section class="section section-light page-intro">
    <div class="container page-hero-grid">
      <div>
        <span class="eyebrow">Atendimento na Zona Norte</span>
        <h1>Conserto de Máquina de Lavar na Zona Norte do Rio de Janeiro</h1>
        <p class="page-hero-lede">
          Atendimento residencial em diferentes bairros da Zona Norte do Rio de Janeiro, sempre
          com avaliação técnica da lavadora antes da apresentação do orçamento.
        </p>
        <WhatsAppButton />
      </div>
      <div>
        <Image
          src={images.heroTecnico}
          alt="Técnico avaliando máquina de lavar em residência na Zona Norte do Rio de Janeiro"
          title="Conserto de máquina de lavar na Zona Norte RJ"
          width={560}
          height={700}
          loading="eager"
          fetchpriority="high"
          class="page-hero-img"
        />
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container narrow">
      <SectionHeader
        align="left"
        eyebrow="Como trabalhamos"
        title="Conserto de Máquina de Lavar na Zona Norte RJ"
      />
      <p>
        A Zona Norte reúne uma grande variedade de bairros, de regiões mais residenciais como
        Vila Isabel e Grajaú a áreas mais movimentadas como Madureira e Méier. Essa diversidade
        aparece também nos tipos de instalação das máquinas de lavar, o que reforça a
        importância de uma avaliação presencial antes de qualquer indicação de reparo.
      </p>
      <p>
        A lógica é sempre a mesma: primeiro o diagnóstico, depois o orçamento — sem promessas de
        valores fechados sem antes conhecer o defeito.
      </p>
    </div>
  </section>

  <section class="section section-light">
    <div class="container">
      <SectionHeader
        eyebrow="Cobertura na Zona Norte"
        title="Bairros Atendidos na Zona Norte"
        lede="Atendimento residencial nos seguintes bairros da Zona Norte do Rio de Janeiro."
      />
      <NeighborhoodList neighborhoods={zonaNorteNeighborhoods} />
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <SectionHeader eyebrow="O que oferecemos" title="Serviços Disponíveis" />
      <div class="grid grid-3">
        {services.map((service) => (
          <ServiceCard icon={service.icon} title={service.title} description={service.description} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="container">
      <SectionHeader
        eyebrow="Marcas atendidas"
        title="Marcas de Máquinas de Lavar Atendidas na Zona Norte"
        lede="Atendimento a diferentes fabricantes e modelos de lavadoras residenciais."
      />
      <div class="grid grid-4">
        {brands.map((brand) => (
          <BrandCard
            image={brand.image}
            alt={`${brand.alt} na Zona Norte do Rio de Janeiro`}
            imageTitle={`Máquinas de lavar ${brand.title.replace('Máquinas de Lavar ', '')} na Zona Norte RJ`}
            title={brand.title}
            description={brand.description}
          />
        ))}
      </div>
      <p class="section-note">
        As marcas mencionadas pertencem aos seus respectivos titulares. O atendimento é realizado
        de forma especializada e independente.
      </p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <SectionHeader
        align="left"
        eyebrow="Processo"
        title="Como Funciona o Atendimento na Zona Norte"
        lede="Um fluxo simples do primeiro contato até o teste final do equipamento."
      />
      <MiniSteps steps={serviceProcessSteps} />
    </div>
  </section>

  <section class="section section-light">
    <div class="container narrow">
      <SectionHeader align="left" eyebrow="Transparência" title="Orçamento e Aprovação do Serviço" />
      <p>
        O valor do reparo é apresentado somente após o diagnóstico, com explicação sobre o
        defeito encontrado e as peças envolvidas, quando necessárias. Nada é executado sem a sua
        aprovação, em qualquer bairro atendido da Zona Norte.
      </p>
    </div>
  </section>

  <CTASection
    title="Precisa de Conserto de Máquina de Lavar na Zona Norte RJ?"
    description="Envie a marca, o modelo, o defeito observado e o bairro pelo WhatsApp para receber a avaliação inicial."
    showPhone={true}
  />
</BaseLayout>

<style>
  .page-intro {
    padding-top: clamp(32px, 5vw, 56px);
    padding-bottom: clamp(28px, 4vw, 44px);
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }

  .page-hero-grid > * {
    min-width: 0;
  }

  .page-intro h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    color: var(--primary);
    max-width: 30ch;
  }

  .page-hero-lede {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 40rem;
    margin-bottom: 24px;
  }

  .page-hero-img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .narrow {
    max-width: 760px;
  }

  @media (max-width: 860px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
